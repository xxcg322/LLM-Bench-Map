{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/benchmark/metadata_triage_twofield_strict_v1.schema.json",
  "title": "Two-field strict LLM benchmark metadata triage V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["i", "p", "t"],
        "properties": {
          "i": {"const": 0},
          "p": {"type": "string", "enum": ["B", "N", "U"]},
          "t": {"type": "string", "enum": ["L", "N", "U"]}
        }
      }
    }
  }
}
